    given-names: Chris
  - family-names: Kershaw
    given-names: Nathan
    email: nkershaw@uwo.ca
repository-code: "https://github.com/nkershaw01/RedZeD"
license: MIT
keywords:
  - persistent homology
  - topological data analysis
  - Vietoris-Rips
  - computational topology

